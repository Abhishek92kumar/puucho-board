</header><div class="entry-content">
<p><style>
.subject-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
    padding: 20px;
    max-width: 1200px;
    margin: 0 auto;
}

.subject-card {
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    background: #ffffff;
}

.subject-header {
    background: #333333; /* Dark Gray */
    color: #fff;
    padding: 15px;
    text-align: center;
    font-family: Arial, sans-serif;
    font-weight: bold;
    font-size: 1.5rem; /* Increased font size */
}

.subject-links {
    padding: 15px;
    text-align: center; /* Center align text */
}

.subject-links a {
    display: block;
    color: #000000; /* Black */
    text-decoration: none;
    padding: 10px;
    margin: 5px 0;
    background: #f5f5f5; /* Light Gray */
    border-radius: 4px;
    transition: background 0.3s ease;
    font-family: Arial, sans-serif;
}

.subject-links a:hover {
    background: #e0e0e0; /* Slightly Darker Gray */
}
</style></p>
<div class="subject-grid"><!-- English -->
<div class="subject-card">
<div class="subject-header">English</div>
<div class="subject-links"><a href="https://classnotes.org.in/english/grammar/">English Grammar</a> <a href="https://classnotes.org.in/english/phonics-sounds/">Phonics Sounds</a> <a href="https://classnotes.org.in/english/essay-english/">Essays</a> <a href="https://classnotes.org.in/english/general/">General English</a></div>
</div>
<!-- Hindi -->
<div class="subject-card">
<div class="subject-header">Hindi</div>
<div class="subject-links"><a href="https://classnotes.org.in/hindi/matrayen/">हिन्दी मात्राएँ</a> <a href="https://classnotes.org.in/hindi/vyakaran/">हिन्दी व्याकरण</a> <a href="https://classnotes.org.in/hindi/name/">पशु, पक्षियों, वस्तुओं के नाम</a></div>
</div>
<!-- Class 6 -->
<div class="subject-card">
<div class="subject-header">Class 6</div>
<div class="subject-links"><a href="https://classnotes.org.in/class-6/science-6/">Science Notes</a> <a href="https://classnotes.org.in/class-6/social-science-6/">Social Science Notes</a></div>
</div>
<!-- Class 7 -->
<div class="subject-card">
<div class="subject-header">Class 7</div>
<div class="subject-links"><a href="https://classnotes.org.in/class-7/">Science Notes</a></div>
</div>
<!-- Class 8 -->
<div class="subject-card">
<div class="subject-header">Class 8</div>
<div class="subject-links"><a href="https://classnotes.org.in/class-8/english-8/">English Notes</a> <a href="https://classnotes.org.in/class-8/science-8/">Science Notes</a> <a href="https://classnotes.org.in/class-8/social-science-8/">Social Science Notes</a></div>
</div>
<!-- Class 9 -->
<div class="subject-card">
<div class="subject-header">Class 9</div>
<div class="subject-links"><a href="https://classnotes.org.in/class-9/class-9-english-notes/">English Notes</a> <a href="https://classnotes.org.in/class-9/science-9/">Science Notes</a> <a href="https://classnotes.org.in/class-9/class-9-social-science-notes/">Social Science Notes</a></div>
</div>
<!-- Class 10 -->
<div class="subject-card">
<div class="subject-header">Class 10</div>
<div class="subject-links"><a href="https://classnotes.org.in/class-10/hindi-10/">Hindi Notes</a> <a href="https://classnotes.org.in/class-10/english-10/">English Notes</a> <a href="https://classnotes.org.in/class-10/science-10/">Science Notes</a> <a href="https://classnotes.org.in/class-10/social-science-10/">Social Science Notes</a></div>
</div>
<!-- Class 11 and Class 12 -->
<div class="subject-card">
<div class="subject-header">Class 11</div>
<div class="subject-links"><a href="https://classnotes.org.in/class-11/">Chemistry Notes</a></div>
<div class="subject-header">Class 12</div>
<div class="subject-links"><a href="https://classnotes.org.in/class-12/">Chemistry Notes</a></div>
</div>
</div>
<!-- CONTENT END 1 -->
</div></article></main><aside class="sidebar sidebar-primary widget-area" role="complementary" aria-label="Primary Sidebar" id="genesis-sidebar-primary"><h2 class="genesis-sidebar-title screen-reader-text">Primary Sidebar</h2><section id="simple-social-icons-2" class="widget simple-social-icons"><div class="widget-wrap"><ul class="aligncenter"><li class="ssi-facebook"><a href="https://www.facebook.com/classnotes.org.in/" target="_blank" rel="noopener" aria-label="Facebook"><svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg></a></li><li class="ssi-pinterest"><a href="https://www.pinterest.com/class_notes" target="_blank" rel="noopener" aria-label="Pinterest"><svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor"><path d="M12 0C5.373 0 0 5.372 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738a.36.36 0 0 1 .083.345l-.333 1.36c-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.631-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24 12 24c6.627 0 12-5.373 12-12 0-6.628-5.373-12-12-12z"/></svg></a></li><li class="ssi-twitter"><a href="https://x.com/ClassNotes7" target="_blank" rel="noopener" aria-label="Twitter"><svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor"><path d